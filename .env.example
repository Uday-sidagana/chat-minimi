OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# none is the default fast path. Set low/medium for more reasoning.
REASONING_EFFORT=none
# Optional for hosted deployments. Local development uses .data/minimi.sqlite.
DATABASE_URL=
# Optional shared password for a private hosted reviewer demo.
DEMO_PASSWORD=
MAX_DAILY_TURNS=200
